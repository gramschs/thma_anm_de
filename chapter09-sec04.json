us Abschnitt 9.3.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"jpSFLBlbx0"}],"key":"Gc4WSkQjTx"},{"type":"code","lang":"python","value":"import numpy as np\nfrom scipy.integrate import quad\n\ndef simpson(t, v):\n    n  = len(v)\n    dt = t[1] - t[0]\n    if n % 2 == 0:\n        raise ValueError(\n            f\"Simpson-Regel erfordert ungerade Punktanzahl, erhalten: {n}\"\n        )\n    gewichte         = np.ones(n)\n    gewichte[1:-1:2] = 4\n    gewichte[2:-2:2] = 2\n    return (dt / 3) * np.dot(gewichte, v)\n\n# Experiment A\nt_a = np.linspace(0, 4, 8)\nv_a = t_a**2\nprint(f\"Experiment A: {simpson(t_a, v_a):.4f}\")\n\n# Experiment B\nt_b = np.linspace(0, 4, 9)\nv_b = t_b**2\nprint(f\"Experiment B: {simpson(t_b, v_b):.4f}\")\n\n# Experiment C\nergebnis_c, fehler_c = quad(lambda x: x**2, 0, 4)\nprint(f\"Experiment C: {ergebnis_c:.4f},  Fehlerabschätzung: {fehler_c:.2e}\")","position":{"start":{"line":14,"column":1},"end":{"line":43,"column":1}},"key":"EO9DjkgZTv"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":45,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Was gibt Experiment A aus? Begründen Sie ohne Code.","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"SvTVJLWS7M"}],"key":"BqtiFDQwOe"}],"key":"BJywKCaeLq"},{"type":"listItem","spread":true,"position":{"start":{"line":46,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Das exakte Integral ","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"rzCamWQTcy"},{"type":"inlineMath","value":"\\int_0^4 x^2\\,\\mathrm{d}x = 64/3 \\approx 21.3333","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"html":"<span class=\"katex\"><spa