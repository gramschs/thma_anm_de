Fehler quad:     {abs(W_quad   - W_exakt) / W_exakt * 100:.3f} %\")\n\n# --- Teilaufgabe 4: Plot ---\nfig, ax = plt.subplots(figsize=(7, 4))\nax.plot(x_mess * 100, F_exakt, color='#005A94', linewidth=2,\n        label='Modell $F = k_1 x + k_3 x^3$')\nax.plot(x_mess * 100, F_mess,  color='#E60000', linewidth=1, linestyle='--',\n        marker='o', markersize=5, label='Messung')\nax.set_xlabel('Auslenkung $x$ in cm')\nax.set_ylabel('Federkraft $F$ in N')\nax.set_title('Nichtlineare Federkennlinie')\nax.legend()\nax.grid(True)\nplt.tight_layout()\nplt.show()","position":{"start":{"line":171,"column":1},"end":{"line":223,"column":1}},"key":"CpKOrSGVmV"},{"type":"paragraph","position":{"start":{"line":225,"column":1},"end":{"line":225,"column":1}},"children":[{"type":"text","value":"Erwartete Ausgabe:","position":{"start":{"line":225,"column":1},"end":{"line":225,"column":1}},"key":"XtW660LN8w"}],"key":"WaTaJIPBM2"},{"type":"code","lang":"","value":"Arbeit (Trapezregel): 10.0046 J\nArbeit (quad):        10.0125 J  (Fehlerabsch.: 1.11e-13)\nArbeit (exakt):       10.0125 J\n\nRel. Fehler Trapez:   0.079 %\nRel. Fehler quad:     0.000 %","position":{"start":{"line":226,"column":1},"end":{"line":233,"column":1}},"key":"veiKnMBW4B"},{"type":"paragraph","position":{"start":{"line":235,"column":1},"end":{"line":237,"column":1}},"children":[{"type":"text","value":"Die geleistete Arbeit beim Einfedern auf 30 cm beträgt rund 10 J.\nDer kubische Term trägt dabei etwa ","position":{"start":{"line":235,"column":1},"end":{"line":235,"column":1}},"key":"tIXRngTKbr"},{"type":"inlineMath","value":"k_3\\,x_\\text{max}^4/4 \\approx 1.0","position":{"start":{"line":235,"column":1},"end":{"line":235,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>k</mi><mn>3</mn></msub><mtext> </mtext><msubsup><mi>x</mi><mtext>max</mtext><mn>4</mn></msubsup><mi mathvariant=\"normal\">/</mi><mn>4</mn><mo>≈</m