"key":"kbkGFDKt3f"}],"key":"FDhpH2f8Dj"},{"type":"code","lang":"python","value":"import numpy as np\nimport matplotlib.pyplot as plt\nimport matplotlib.style as style\nstyle.use('seaborn-v0_8')\n\nnp.random.seed(12)\n\n# --- Eingabe: Bremsmodell und Messdaten ---\nv0 = 100 / 3.6        # Anfangsgeschwindigkeit in m/s\nk  = 0.35             # Abklingkonstante in 1/s\nT  = 8.0              # Messdauer in s\ndt = 0.5              # Abtastrate in s\n\nt_mess   = np.arange(0, T + dt, dt)\nv_exakt  = v0 * np.exp(-k * t_mess)\nrauschen = np.random.normal(0, 0.3, size=len(t_mess))\nv_mess   = np.maximum(v_exakt + rauschen, 0.0)\n\n# --- Teilaufgabe 1: numerischer Weg ---\nweg_trapez = np.trapezoid(v_mess, t_mess)\nprint(f\"Zurückgelegter Weg (Trapezregel): {weg_trapez:.2f} m\")\n\n# --- Teilaufgabe 2: analytischer Weg und relativer Fehler ---\n# Stammfunktion von v0*exp(-k*t): -v0/k * exp(-k*t)\n# Auswertung von 0 bis T ergibt v0/k * (1 - exp(-k*T))\nweg_exakt  = (v0 / k) * (1 - np.exp(-k * T))\nrelativer_fehler = abs(weg_trapez - weg_exakt) / weg_exakt * 100\n\nprint(f\"Zurückgelegter Weg (analytisch): {weg_exakt:.2f} m\")\nprint(f\"Relativer Fehler: {relativer_fehler:.3f} %\")\n\n# --- Teilaufgabe 3: Plot ---\nfig, ax = plt.subplots(figsize=(8, 4))\nax.plot(t_mess, v_exakt, color='#005A94', linewidth=2,\n        label='Modell $v(t) = v_0 e^{-kt}$')\nax.plot(t_mess, v_mess,  color='#E60000', linewidth=1, linestyle='--',\n        marker='o', markersize=4, label='Sensormessung (mit Rauschen)')\nax.set_xlabel('Zeit in s')\nax.set_ylabel('Geschwindigkeit in m/s')\nax.set_title('Notbremsung: Geschwindigkeitsverlauf')\nax.legend()\nax.grid(True)\nplt.tight_layout()\nplt.show()","position":{"start":{"line":163,"column":1},"end":{"line":208,"column":1}},"key":"rjixxxB0f6"},{"type":"paragraph","position":{"start":{"line":210,"column":1},"end":{"line":210,"column":1}},"children":[{"type":"text","value":"Erwartete Ausgabe:","position":{"start":{"line":210,"column":1},"end":{"line":210,"column":1}},"key":"AIoOQCrgqf"}],"key":"pCwkcuyqLo"},{"type":"code","lang":"","value":"Zurückgelegter Weg (Trapezregel): 74.84 m\nZurückgelegter Weg (analytisch):  74.54 m\nRelativer Fehler:       0.405 %","position":{"start":{"line":211,"column":1},"end":{"line":215,"column":1}},"key":"oCohSnSO5z"},{"type":"paragraph","position":{"start":{"line":217,"column":1},"end":{"line":218,"column":1}},"children":[{"type":"text","value":"Der numerische zurückgelegte Weg beträgt knapp 75 m bei einer Notbremsung aus\n100 km/h. Das entspricht typischen Werten auf nasser Straße.","position":{"start":{"line":217,"column":1},"end":{"line":217,"column":1}},"key":"b4MhBIyvWR"}],"key":"sXOApXOxZO"},{"type":"paragraph","position":{"start":{"line":220,"column":1},"end":{"line":225,"column":1}},"children":[{"type":"text","value":"Zu Frage 4: Das Sensorrauschen ist normalverteilt mit Erwartungswert null.\nÜber 17 Messpunkte heben sich positive und negative Abweichungen weitgehend\nauf, sodass die Summe aller Trapezflächen kaum verfälscht wird. Numerische\nIntegration ist deshalb deutlich robuster gegenüber Messrauschen als\nnumerische Differentiation, bei der bereits ein einzelner Ausreißer den\nlokalen Gradienten stark verfälscht.","position":{"start":{"line":220,"column":1},"end":{"line":220,"column":1}},"key":"dfP347VVeQ"}],"key":"vfzbVIMTza"}],"class":"tip dropdown","key":"hcffbCOvEu"}],"key":"IhJmTQd74Q"}],"key":"Ig8HZUDQ9C"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"9.1 Rechteck- und Trapezregel","url":"/chapter09-sec01","group":"9. Numerische Integration"},"next":{"title":"9.3 Simpson-Regel und scipy.integrate.quad","url":"/chapter09-sec03","group":"9. Numerische Integration"}}},"domain":"http://localhost:3000"}